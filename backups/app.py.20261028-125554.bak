@app.route("/")
def index():
    return render_template(
        "index.html",
        meta_title="Business Travel — путешествия, продуманные до мелочей | Томск",
        meta_description="Туристическое агентство Business Travel в Томске: организация мероприятий, деловые поездки и индивидуальные путешествия.",
    )


@app.route("/tours")
def catalog():
    rows, total, page, pages = query_tours(request.args)
    destinations, cities, meals, vtypes = filter_options()
    return render_template(
        "catalog.html",
        tours=rows,
        total=total,
        page=page,
        pages=pages,
        destinations=destinations,
        departure_cities=cities,
        meal_types=meals,
        vacation_types=vtypes,
        meta_title="Каталог туров — Business Travel",
        meta_description="Все актуальные предложения Business Travel: фильтры по стране, датам, бюджету, типу отдыха и питанию.",
    )


@app.route("/api/tours")
def api_tours():
    try:
        rows, total, page, pages = query_tours(request.args)
    except Exception:
        app.logger.exception("Ошибка запроса каталога")
        return jsonify({"error": "Не удалось загрузить туры. Попробуйте ещё раз."}), 500
    return jsonify({
        "items": [tour_to_dict(t) for t in rows],
        "total": total,
        "page": page,
        "pages": pages,
    })


@app.route("/destinations/<slug>")
def destination_page(slug):
    conn = database.get_db()
    dest = conn.execute("SELECT * FROM destinations WHERE slug = ?", (slug,)).fetchone()
    if not dest:
        conn.close()
        abort(404)
    tours = conn.execute(
        """SELECT t.*, d.name AS country_name, d.slug AS country_slug
           FROM tours t JOIN destinations d ON d.id = t.destination_id
           WHERE t.destination_id = ? AND t.status = 'active'
           ORDER BY t.priority DESC, t.price ASC""",
        (dest["id"],),
    ).fetchall()
    conn.close()
    return render_template(
        "destination.html",
        dest=dest,
        tours=tours,
        meta_title=f"Туры: {dest['name']} — Business Travel",
        meta_description=dest["description"],
    )


@app.route("/tours/<int:tour_id>")
def tour_page(tour_id):
    conn = database.get_db()
    tour = conn.execute(
        """SELECT t.*, d.name AS country_name, d.slug AS country_slug
           FROM tours t JOIN destinations d ON d.id = t.destination_id
           WHERE t.id = ? AND t.status = 'active'""",
        (tour_id,),
    ).fetchone()
    if not tour:
        conn.close()
        abort(404)
    similar = conn.execute(
        """SELECT t.*, d.name AS country_name, d.slug AS country_slug
           FROM tours t JOIN destinations d ON d.id = t.destination_id
           WHERE t.destination_id = ? AND t.id != ? AND t.status = 'active'
           ORDER BY t.priority DESC LIMIT 3""",
        (tour["destination_id"], tour_id),
    ).fetchall()
    conn.close()
    return render_template(
        "tour.html",
        tour=tour,
        similar=similar,
        meta_title=f"{tour['title']} — Business Travel",
        meta_description=f"{tour['title']}: {tour['country_name']}, {tour['resort']}, {tour['nights']} ночей, вылет из {tour['departure_city']}.",
    )


@app.route("/specials")
def specials():
    conn = database.get_db()
    tours = conn.execute(
        """SELECT t.*, d.name AS country_name, d.slug AS country_slug
           FROM tours t JOIN destinations d ON d.id = t.destination_id
           WHERE t.is_special = 1 AND t.status = 'active'
           ORDER BY t.priority DESC, t.price ASC""").fetchall()
