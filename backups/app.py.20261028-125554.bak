"""Business Travel — публичная часть сайта и API."""
import os
import re
import uuid

from flask import (Flask, abort, jsonify, redirect, render_template, request,
                   url_for)

import db as database
import telegram_notify
from security import (admin_login_limiter, client_ip, csrf_protect,
                      get_csrf_token, request_form_limiter)

app = Flask(__name__)
app.secret_key = os.environ.get("SECRET_KEY") or os.urandom(32)
app.config["MAX_CONTENT_LENGTH"] = 256 * 1024  # заявки не должны быть огромными

PER_PAGE = 12

# Приблизительные курсы для отображения (обновляет владелец; не для расчётов)
CURRENCY_RATES = {"RUB": (1.0, "₽"), "USD": (90.0, "$"), "EUR": (98.0, "€")}

PHONE_RE = re.compile(r"^\+?[\d\s\-()]{10,18}$")
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


# ---------------------------------------------------------------------------
# Общие хелперы
# ---------------------------------------------------------------------------

def get_settings():
    conn = database.get_db()
    rows = conn.execute("SELECT key, value FROM settings").fetchall()
    conn.close()
    return {r["key"]: r["value"] for r in rows}


@app.context_processor
def inject_globals():
    return {
        "settings": get_settings(),
        "csrf_token": get_csrf_token,
        "telegram_configured": telegram_notify.is_configured(),
    }


@app.before_request
def before_request():
    csrf_protect()


def format_price(price, currency="RUB"):
    rate, symbol = CURRENCY_RATES.get(currency, CURRENCY_RATES["RUB"])
    value = round(price / rate)
    return f"{value:,}".replace(",", " ") + f" {symbol}"


app.jinja_env.filters["price"] = format_price


def query_tours(args):
    """Серверная фильтрация, сортировка и пагинация каталога."""
    where = ["t.status = 'active'"]
    params = []

    def add(cond, *vals):
        where.append(cond)
        params.extend(vals)

    if args.get("country"):
        add("d.slug = ?", args["country"])
    if args.get("resort"):
        add("t.resort LIKE ?", f"%{args['resort'].strip()}%")
    if args.get("departure_city"):
        add("t.departure_city = ?", args["departure_city"])
    if args.get("date_from"):
        add("t.date_to >= ?", args["date_from"])
    if args.get("date_to"):
        add("t.date_from <= ?", args["date_to"])
    if args.get("nights_min", type=int):
        add("t.nights >= ?", args["nights_min"])
    if args.get("nights_max", type=int):
        add("t.nights <= ?", args["nights_max"])
    if args.get("price_min", type=int):
        add("t.price >= ?", args["price_min"])
    if args.get("price_max", type=int):
        add("t.price <= ?", args["price_max"])
    if args.get("stars", type=int):
        add("t.hotel_stars >= ?", args["stars"])
    if args.get("meal_type"):
        add("t.meal_type = ?", args["meal_type"])
    if args.get("vacation_type"):
        add("t.vacation_type = ?", args["vacation_type"])
    if args.get("tourists", type=int):
        add("t.persons >= ?", args["tourists"])
    if args.get("special") == "1":
        add("t.is_special = 1")

    sorts = {
        "price_asc": "t.price ASC",
        "price_desc": "t.price DESC",
        "nights": "t.nights DESC",
        "date": "t.date_from ASC",
        "newest": "t.created_at DESC",
        "priority": "t.priority DESC, t.price ASC",
    }
    order = sorts.get(args.get("sort", "priority"), sorts["priority"])

    page = max(1, args.get("page", 1, type=int))
    where_sql = " AND ".join(where)

    conn = database.get_db()
    total = conn.execute(
        f"SELECT COUNT(*) AS c FROM tours t JOIN destinations d ON d.id = t.destination_id WHERE {where_sql}",
        params,
    ).fetchone()["c"]
    pages = max(1, (total + PER_PAGE - 1) // PER_PAGE)
    page = min(page, pages)
    rows = conn.execute(
        f"""SELECT t.*, d.name AS country_name, d.slug AS country_slug
            FROM tours t JOIN destinations d ON d.id = t.destination_id
            WHERE {where_sql} ORDER BY {order}
            LIMIT ? OFFSET ?""",
        params + [PER_PAGE, (page - 1) * PER_PAGE],
    ).fetchall()
    conn.close()
    return rows, total, page, pages


def tour_to_dict(t):
    return {
        "id": t["id"],
        "title": t["title"],
        "country": t["country_name"],
        "country_slug": t["country_slug"],
        "resort": t["resort"],
        "hotel_name": t["hotel_name"],
        "hotel_stars": t["hotel_stars"],
        "date_from": t["date_from"],
        "date_to": t["date_to"],
        "nights": t["nights"],
        "meal_type": t["meal_type"],
        "departure_city": t["departure_city"],
        "vacation_type": t["vacation_type"],
        "price_display": format_price(t["price"], request.args.get("currency", "RUB")),
        "persons": t["persons"],
        "image": url_for("static", filename=t["image"]) if t["image"] else "",
        "is_special": bool(t["is_special"]),
        "price_needs_confirmation": bool(t["price_needs_confirmation"]),
        "url": url_for("tour_page", tour_id=t["id"]),
    }


def filter_options():
    """Значения для выпадающих списков фильтров (из реальных данных)."""
    conn = database.get_db()
    destinations = conn.execute(
        "SELECT slug, name FROM destinations ORDER BY sort_order").fetchall()
    cities = [r[0] for r in conn.execute(
        "SELECT DISTINCT departure_city FROM tours WHERE status='active' ORDER BY 1").fetchall()]
    meals = [r[0] for r in conn.execute(
        "SELECT DISTINCT meal_type FROM tours WHERE status='active' AND meal_type != '' ORDER BY 1").fetchall()]
    vtypes = [r[0] for r in conn.execute(
        "SELECT DISTINCT vacation_type FROM tours WHERE status='active' ORDER BY 1").fetchall()]
    conn.close()
    return destinations, cities, meals, vtypes


