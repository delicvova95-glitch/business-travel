# ---------------------------------------------------------------------------
# Заявки
# ---------------------------------------------------------------------------

SERVICE_LABELS = {
    "events": "Организация мероприятий",
    "business": "Деловые поездки",
    "individual": "Индивидуальные путешествия",
    "other": "Другое",
}


def validate_request_form(data):
    errors = {}
    name = (data.get("name") or "").strip()
    phone = (data.get("phone") or "").strip()
    email = (data.get("email") or "").strip()

    if not name or len(name) > 100:
        errors["name"] = "Укажите имя (до 100 символов)."
    digits = re.sub(r"\D", "", phone)
    if not PHONE_RE.match(phone) or len(digits) < 10 or len(digits) > 15:
        errors["phone"] = "Укажите корректный телефон, например +7 999 123-45-67."
    if email and not EMAIL_RE.match(email):
        errors["email"] = "Проверьте адрес электронной почты."
    if data.get("contact_pref", "phone") not in ("phone", "whatsapp", "telegram", "email"):
        errors["contact_pref"] = "Выберите способ связи."
    if data.get("service") and data["service"] not in SERVICE_LABELS:
        errors["service"] = "Выберите услугу."
    if str(data.get("consent_pd")) not in ("1", "true", "on"):
        errors["consent_pd"] = "Для отправки заявки необходимо согласие на обработку персональных данных."
    for field in ("country", "dates", "tourists", "budget", "comment"):
        if len(data.get(field) or "") > 500:
            errors[field] = "Слишком длинное значение."
    return errors


@app.route("/api/requests", methods=["POST"])
def create_request():
    if not request_form_limiter.allow(client_ip()):
        return jsonify({"error": "Слишком много отправок. Попробуйте позже."}), 429

    data = request.form if request.form else (request.get_json(silent=True) or {})
    errors = validate_request_form(data)
    if errors:
        return jsonify({"errors": errors}), 400

    tour_id = data.get("tour_id", type=int) if data.get("tour_id") else None
    idem = (data.get("idempotency_key") or "").strip() or str(uuid.uuid4())

    # Выбранная услуга сохраняется первой строкой комментария
    service = (data.get("service") or "").strip()
    comment = (data.get("comment") or "").strip()
    if service in SERVICE_LABELS:
        comment = f"Услуга: {SERVICE_LABELS[service]}." + (f" {comment}" if comment else "")

    conn = database.get_db()
    if tour_id:
        exists = conn.execute(
            "SELECT id FROM tours WHERE id = ? AND status='active'", (tour_id,)).fetchone()
        if not exists:
            conn.close()
            return jsonify({"errors": {"tour_id": "Выбранный тур не найден."}}), 400

    # Идемпотентность: повторная отправка с тем же ключом вернёт существующую заявку
    existing = conn.execute(
        "SELECT * FROM requests WHERE idempotency_key = ?", (idem,)).fetchone()
    if existing:
        conn.close()
        return jsonify({
            "ok": True,
            "number": existing["public_number"],
            "redirect": url_for("request_success", number=existing["public_number"]),
            "duplicate": True,
        })

    public_number = database.next_public_number(conn)
    conn.execute(
        """INSERT INTO requests (
            public_number, name, phone, email, contact_pref, country, dates,
            tourists, budget, comment, tour_id, source_page, consent_pd, idempotency_key
        ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
        (
            public_number,
            data["name"].strip(),
            data["phone"].strip(),
            (data.get("email") or "").strip(),
            data.get("contact_pref", "phone"),
            (data.get("country") or "").strip(),
            (data.get("dates") or "").strip(),
            (data.get("tourists") or "").strip(),
            (data.get("budget") or "").strip(),
            comment,
            tour_id,
            (data.get("source_page") or "").strip()[:200],
            1,
            idem,
        ),
    )
    conn.commit()
    saved = conn.execute("SELECT * FROM requests WHERE public_number = ?",
                         (public_number,)).fetchone()

    tour_title = None
    if tour_id:
        row = conn.execute("SELECT title FROM tours WHERE id = ?", (tour_id,)).fetchone()
        tour_title = row["title"] if row else None

    tg_status = telegram_notify.send_request_notification(saved, tour_title)
    conn.execute(
        "UPDATE requests SET telegram_status = ?, telegram_attempts = telegram_attempts + 1 WHERE id = ?",
        (tg_status, saved["id"]),
    )
    conn.commit()
    conn.close()

    return jsonify({
        "ok": True,
        "number": public_number,
        "redirect": url_for("request_success", number=public_number),
    })


@app.route("/request/success/<number>")
def request_success(number):
    conn = database.get_db()
    req = conn.execute(
        "SELECT * FROM requests WHERE public_number = ?", (number,)).fetchone()
    conn.close()
    if not req:
        abort(404)
    return render_template(
        "request_success.html",
        req=req,
        meta_title="Заявка отправлена — Business Travel",
        meta_description="Ваша заявка принята в работу.",
    )


# ---------------------------------------------------------------------------
# Ошибки
# ---------------------------------------------------------------------------

@app.errorhandler(404)
def not_found(e):
    return render_template(
        "404.html",
        meta_title="Страница не найдена — Business Travel",
        meta_description="Запрошенная страница не существует.",
    ), 404


@app.errorhandler(400)
def bad_request(e):
    return render_template(
        "404.html",
        meta_title="Ошибка запроса — Business Travel",
        meta_description="Запрос не может быть обработан.",
        error_message=getattr(e, "description", "Ошибка запроса."),
    ), 400


@app.errorhandler(500)
def server_error(e):
    app.logger.exception("Внутренняя ошибка сервера")
    return render_template(
        "404.html",
        meta_title="Ошибка сервера — Business Travel",
        meta_description="Произошла внутренняя ошибка. Попробуйте позже.",
        error_message="Произошла внутренняя ошибка. Мы уже разбираемся.",
    ), 500


