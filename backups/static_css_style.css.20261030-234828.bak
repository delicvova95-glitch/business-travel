/* ==========================================================================
   Business Travel — дизайн-система
   ========================================================================== */

:root {
  --navy: #10233F;
  --navy-2: #172B46;
  --gold: #C7A66A;
  --bg: #F7F8FA;
  --white: #FFFFFF;
  --text: #202B3C;
  --muted: #687386;
  --border: #E4E8EF;
  --radius: 12px;
  --shadow: 0 4px 20px rgba(16, 35, 63, 0.07);
  --font-head: "Playfair Display", Georgia, serif;
  --font-body: "Inter", -apple-system, "Segoe UI", Roboto, sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  color: var(--text);
  background: var(--bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { color: var(--navy); text-decoration: none; }
a:hover { color: var(--gold); }
h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.2; color: var(--navy); }
h1 { font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 700; }
h2 { font-size: clamp(1.4rem, 2.6vw, 2rem); }
h3 { font-size: 1.15rem; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.muted { color: var(--muted); }
.small { font-size: 0.85rem; }

/* --- Кнопки -------------------------------------------------------------- */
.btn {
  display: inline-block; padding: 12px 26px; border-radius: 8px;
  font: 600 0.95rem var(--font-body); cursor: pointer; border: 1px solid transparent;
  transition: background .2s, color .2s, border-color .2s, transform .15s;
  text-align: center;
}
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--navy); color: #fff; }
.btn-primary:hover { background: var(--navy-2); color: #fff; }
.btn-gold { background: var(--gold); color: var(--navy); }
.btn-gold:hover { background: #b8965a; color: var(--navy); }
.btn-outline { background: transparent; border-color: var(--navy); color: var(--navy); }
.btn-outline:hover { background: var(--navy); color: #fff; }
.btn-ghost { background: transparent; color: var(--muted); }
.btn-ghost:hover { color: var(--navy); }
.btn-sm { padding: 8px 16px; font-size: 0.85rem; }
.btn-lg { padding: 15px 34px; font-size: 1.02rem; }
.btn[disabled] { opacity: .55; pointer-events: none; }

/* --- Шапка --------------------------------------------------------------- */
.header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(16, 35, 63, 0.92); backdrop-filter: blur(10px);
  transition: padding .25s;
}
.header-inner { display: flex; align-items: center; gap: 28px; padding-top: 16px; padding-bottom: 16px; }
.header.compact .header-inner { padding-top: 8px; padding-bottom: 8px; }
.logo { display: flex; align-items: center; gap: 10px; }
.logo-text { font-family: var(--font-head); font-size: 1.25rem; font-weight: 600; color: #fff; white-space: nowrap; }
.logo-text em { font-style: normal; color: var(--gold); }
.logo-light .logo-text { color: #fff; }
.nav { display: flex; gap: 15px; flex: 1; justify-content: center; }
.nav a { color: rgba(255,255,255,.82); font-size: 0.86rem; font-weight: 500; white-space: nowrap; }
.nav a:hover { color: var(--gold); }
.header-contacts { display: flex; align-items: center; gap: 18px; }
.header-phone { color: #fff; font-weight: 600; font-size: 0.95rem; }
.header-phone:hover { color: var(--gold); }
.burger { display: none; background: none; border: 0; cursor: pointer; padding: 10px; }
.burger span { display: block; width: 24px; height: 2px; background: #fff; margin: 5px 0; transition: .25s; }

/* --- Первый экран --------------------------------------------------------- */
/* Взлётная полоса 300vh: сцена «приклеена» (sticky), прогресс 0..1 — прокрутка */
.hero { position: relative; height: 300vh; background: #060a1c; }
.hero-stage {
  position: sticky; top: 0; height: 100vh;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; text-align: left;
}
.hero-canvas { position: absolute; inset: 0; z-index: 1; }
.hero-canvas canvas { width: 100% !important; height: 100% !important; display: block; }
.hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(6,10,28,.35), rgba(6,10,28,.55)); }
.hero-content { position: relative; z-index: 2; color: #fff; padding-top: 90px; width: 100%; min-width: 0; }
.hero-content h1 { color: #fff; max-width: 640px; margin: 14px 0 18px; }
.hero-kicker { color: var(--gold); letter-spacing: .18em; text-transform: uppercase; font-size: .8rem; font-weight: 600; }
.hero-brand {
  color: var(--gold); text-transform: uppercase; font-weight: 700;
  letter-spacing: .32em; font-size: clamp(.95rem, 2.2vw, 1.25rem); margin: 10px 0 0;
}
.hero-sub { font-size: 1.15rem; color: rgba(255,255,255,.85); max-width: 560px; }

/* Текст скрыт в начальном кадре и проявляется, когда самолёт обращён к зрителю
   (класс hero-info переключается из globe.js по прогрессу прокрутки) */
.hero-content > * {
  opacity: 0; transform: translateY(16px);
  transition: opacity .9s ease, transform .9s ease;
}
body.hero-info .hero-content > * { opacity: 1; transform: none; }
body.hero-info .hero-content > *:nth-child(1) { transition-delay: .1s; }
body.hero-info .hero-content > *:nth-child(2) { transition-delay: .22s; }
body.hero-info .hero-content > *:nth-child(3) { transition-delay: .34s; }
body.hero-info .hero-content > *:nth-child(4) { transition-delay: .46s; }
body.hero-info .hero-content > *:nth-child(5) { transition-delay: .58s; }
@media (prefers-reduced-motion: reduce) {
  .hero-content > * { opacity: 1; transform: none; transition: none; }
}
.hero-actions { display: flex; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
.hero .btn-ghost { color: #fff; border: 1px solid rgba(255,255,255,.4); }
.hero .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }
.hero-scroll-hint {
  position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%); z-index: 2;
  color: rgba(255,255,255,.55); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
  transition: opacity .6s ease;
}
body.hero-info .hero-scroll-hint { opacity: 0; }

/* --- Секции --------------------------------------------------------------- */
.section { padding: 72px 0; }
.section-alt { background: var(--white); }
.section-title { margin-bottom: 34px; position: relative; }
.section-title::after {
  content: ""; display: block; width: 48px; height: 2px; background: var(--gold); margin-top: 12px;
}
.section-more { text-align: center; margin-top: 34px; }

/* --- Формы ---------------------------------------------------------------- */
.form-field { margin-bottom: 16px; }
.form-field label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 6px; color: var(--navy); }
.form-field input, .form-field select, .form-field textarea {
  width: 100%; padding: 11px 13px; border: 1px solid var(--border); border-radius: 8px;
  font: 400 0.95rem var(--font-body); background: #fff; color: var(--text);
  transition: border-color .2s, box-shadow .2s;
}
.form-field input:focus, .form-field select:focus, .form-field textarea:focus {
  outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(199,166,106,.15);
}
.form-field textarea { resize: vertical; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.req { color: #c0392b; }
.checkbox { display: flex; gap: 10px; align-items: flex-start; font-size: .87rem; color: var(--muted); cursor: pointer; }
.checkbox input { width: auto; margin-top: 4px; }
.field-error { color: #c0392b; font-size: .8rem; margin-top: 4px; min-height: 1em; }
.form-error-global {
  background: #fdecea; border: 1px solid #f5c6c0; color: #a33; border-radius: 8px;
  padding: 10px 14px; margin-bottom: 14px; font-size: .9rem;
}
.form-note { font-size: .8rem; color: var(--muted); margin-top: 12px; }
.checkbox-field { display: flex; align-items: flex-end; }

/* --- Поиск ---------------------------------------------------------------- */
.section-search { margin-top: -60px; position: relative; z-index: 3; }
.search-form {
  background: #fff; border-radius: var(--radius); box-shadow: var(--shadow);
  border: 1px solid var(--border); padding: 30px;
}
.search-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px 18px; }
.search-actions { display: flex; align-items: center; gap: 18px; margin-top: 8px; flex-wrap: wrap; }
.search-note { font-size: .8rem; color: var(--muted); }

/* --- Направления ----------------------------------------------------------- */
.dest-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.dest-card {
  border-radius: var(--radius); overflow: hidden; background: #fff;
  box-shadow: var(--shadow); border: 1px solid var(--border);
  transition: transform .25s, box-shadow .25s;
}
.dest-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(16,35,63,.12); }
.dest-card img { width: 100%; height: 190px; object-fit: cover; }
.dest-card-body { padding: 18px; }
.dest-card-body p { font-size: .87rem; color: var(--muted); margin: 8px 0 10px; }
.dest-count { font-size: .78rem; color: var(--gold); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
.dest-link { display: block; margin-top: 8px; font-size: .87rem; font-weight: 600; color: var(--navy); }
.dest-card:hover .dest-link { color: var(--gold); }

/* --- Карточки направлений (главная) ----------------------------------------- */
.dir-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.dir-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
  overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column;
  transition: transform .25s, box-shadow .25s;
}
.dir-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(16,35,63,.14); }
.dir-card-img { display: block; overflow: hidden; }
.dir-card-img img { width: 100%; height: 230px; object-fit: cover; transition: transform .4s ease; }
.dir-card:hover .dir-card-img img { transform: scale(1.05); }
.dir-card-body { padding: 22px; display: flex; flex-direction: column; flex: 1; align-items: flex-start; }
.dir-card-body h3 { font-size: 1.25rem; margin-bottom: 8px; }
.dir-card-body p { font-size: .92rem; color: var(--muted); margin-bottom: 16px; flex: 1; }

/* --- Подробные направления и проекты (главная) ------------------------------- */
.dir-detail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.dir-detail-item { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 26px 24px; }
.dir-detail-item h3 { margin-bottom: 10px; }
.dir-detail-item p { font-size: .92rem; color: var(--muted); margin-bottom: 14px; }
.projects-empty {
  background: #fff; border: 1px dashed var(--border); border-radius: var(--radius);
  padding: 34px 30px; text-align: center; color: var(--muted);
}
.projects-empty p { max-width: 560px; margin: 0 auto 18px; }
.projects-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.project-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
  overflow: hidden; box-shadow: var(--shadow);
}
.project-card img { width: 100%; height: 200px; object-fit: cover; }
.project-card-body { padding: 20px; }
.project-card-body p { font-size: .9rem; color: var(--muted); margin-top: 8px; }
.project-card-tag { font-size: .74rem; font-weight: 600; color: var(--gold); text-transform: uppercase; letter-spacing: .07em; }

/* --- Тёмные секции и медиа-блоки (главная, страницы услуг) -------------------- */
.section-dark { background: var(--navy); color: rgba(255,255,255,.78); }
.section-dark h2, .section-dark h3 { color: #fff; }
.section-dark p { color: rgba(255,255,255,.78); }
.section-dark .muted { color: rgba(255,255,255,.6); }
.section-dark .feature { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.14); }
.section-dark .feature p { color: rgba(255,255,255,.7); }

.media-split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.media-split img { border-radius: var(--radius); box-shadow: 0 14px 40px rgba(6,10,28,.35); width: 100%; height: 380px; object-fit: cover; }
.media-split h2 { margin-bottom: 16px; }
.media-split p { margin-bottom: 14px; }

.check-list { list-style: none; margin: 18px 0 24px; }
.check-list li { position: relative; padding-left: 26px; margin-bottom: 10px; }
.check-list li::before { content: ""; position: absolute; left: 0; top: .68em; width: 14px; height: 2px; background: var(--gold); }
.section-dark .check-list li { color: rgba(255,255,255,.85); }

.dir-tag { display: inline-block; font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }
.dir-card-featured { border-top: 3px solid var(--gold); }

.steps-6 { grid-template-columns: repeat(3, 1fr); }

/* --- Финальный блок контактов на главной -------------------------------------- */
.contact-panel { background: var(--navy); color: rgba(255,255,255,.8); border-radius: var(--radius); padding: 30px; }
.contact-panel .section-title { color: #fff; }
.contact-panel .contact-list dt { color: rgba(255,255,255,.55); }
.contact-panel .contact-list dd { color: #fff; }
.contact-panel .contact-list a { color: #fff; }
.contact-panel .contact-list a:hover { color: var(--gold); }
.contact-panel .muted { color: rgba(255,255,255,.6); }
.form-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); }

/* --- Карточки туров --------------------------------------------------------- */
.tours-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.tours-grid-sm { grid-template-columns: repeat(3, 1fr); }
.tour-card {
  background: #fff; border-radius: var(--radius); overflow: hidden;
  border: 1px solid var(--border); box-shadow: var(--shadow);
  display: flex; flex-direction: column; transition: transform .25s, box-shadow .25s;
}
.tour-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(16,35,63,.12); }
.tour-card-img { position: relative; display: block; }
.tour-card-img img { width: 100%; height: 200px; object-fit: cover; }
.badge {
  position: absolute; top: 12px; left: 12px; padding: 4px 10px; border-radius: 20px;
  font-size: .72rem; font-weight: 600; letter-spacing: .04em;
}
.badge-gold { background: var(--gold); color: var(--navy); }
.tour-card-body { padding: 18px; display: flex; flex-direction: column; flex: 1; }
.tour-card-meta { font-size: .78rem; color: var(--gold); font-weight: 600; text-transform: uppercase; letter-spacing: .07em; }
.tour-card-title { margin: 6px 0 4px; font-size: 1.08rem; }
.tour-card-hotel { font-size: .88rem; color: var(--muted); }
.stars { color: var(--gold); letter-spacing: 2px; font-size: .8rem; }
.tour-card-facts { list-style: none; font-size: .85rem; color: var(--muted); margin: 12px 0; }
.tour-card-facts li { padding: 2px 0; }
.tour-card-footer {
  margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; gap: 10px;
  border-top: 1px solid var(--border); padding-top: 14px;
}
.tour-card-price { font-family: var(--font-head); font-size: 1.35rem; font-weight: 700; color: var(--navy); }
.tour-card-per { font-size: .78rem; color: var(--muted); }
.price-note { font-size: .72rem; color: #a86a1f; margin-top: 4px; }
.tour-card-actions { display: flex; flex-direction: column; gap: 6px; }

/* --- Преимущества / шаги ---------------------------------------------------- */
.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 20px; }
.feature { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 26px 22px; }
.feature-num { font-family: var(--font-head); color: var(--gold); font-size: 1.5rem; font-weight: 600; }
.feature h3 { margin: 10px 0 8px; font-size: 1.05rem; }
.feature p { font-size: .9rem; color: var(--muted); }
.steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: step; }
.steps li { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 26px 22px; }
.steps span {
  display: inline-flex; width: 40px; height: 40px; border-radius: 50%;
  background: var(--navy); color: #fff; align-items: center; justify-content: center;
  font-family: var(--font-head); font-weight: 700; margin-bottom: 12px;
}
.steps h3 { font-size: 1.02rem; margin-bottom: 8px; }
.steps p { font-size: .88rem; color: var(--muted); }

/* --- FAQ -------------------------------------------------------------------- */
.faq-list details {
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
  padding: 18px 22px; margin-bottom: 12px;
}
.faq-list summary { cursor: pointer; font-weight: 600; color: var(--navy); list-style: none; }
.faq-list summary::before { content: "+"; color: var(--gold); margin-right: 10px; font-weight: 700; }
.faq-list details[open] summary::before { content: "–"; }
.faq-list p { margin-top: 10px; color: var(--muted); font-size: .93rem; }

/* --- CTA -------------------------------------------------------------------- */
.cta-section { background: var(--navy); }
.cta { text-align: center; color: #fff; padding: 30px 0; }
.cta h2 { color: #fff; margin-bottom: 12px; }
.cta p { color: rgba(255,255,255,.8); margin-bottom: 24px; }

/* --- Разное ----------------------------------------------------------------- */
.split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.split .section-title { font-size: 1.35rem; }
.split p { color: var(--muted); margin-bottom: 18px; }
.page-head { background: var(--navy); color: #fff; padding: 140px 0 46px; }
.page-head h1 { color: #fff; }
.page-sub { color: rgba(255,255,255,.75); margin-top: 8px; }
.page-head-img { position: relative; background-size: cover; background-position: center; }
.page-head-img::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,35,63,.55), rgba(16,35,63,.85)); }
.page-head-img .container { position: relative; z-index: 1; }
.breadcrumbs { font-size: .82rem; margin-bottom: 12px; color: rgba(255,255,255,.6); }
.breadcrumbs a { color: rgba(255,255,255,.8); }
.breadcrumbs a:hover { color: var(--gold); }
.prose { max-width: 780px; }
.prose h2 { margin: 30px 0 12px; font-size: 1.3rem; }
.prose p, .prose li { color: var(--text); margin-bottom: 12px; }
.prose ul, .prose ol { padding-left: 22px; margin-bottom: 12px; }
.prose .lead { font-size: 1.12rem; color: var(--navy); }
.contact-list div { margin-bottom: 14px; }
.contact-list dt { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
.contact-list dd { font-size: 1.05rem; color: var(--navy); font-weight: 500; }
.doc-list { list-style: none; padding: 0; margin: 0; }
.doc-list li { margin-bottom: 10px; }
.doc-list a { color: var(--navy); font-weight: 500; border-bottom: 1px solid var(--gold); }
.doc-list a:hover { color: var(--gold); }
.notfound { text-align: center; padding: 80px 0; }
.notfound h1 { font-size: 4rem; color: var(--gold); }
.notfound p { color: var(--muted); margin: 14px 0 26px; }
.success-icon {
  width: 64px; height: 64px; margin: 0 auto 18px; border-radius: 50%;
  background: var(--gold); color: var(--navy); font-size: 2rem;
  display: flex; align-items: center; justify-content: center;
}
.request-number { color: var(--navy); font-family: var(--font-head); font-size: 1.2rem; }

/* --- Каталог ---------------------------------------------------------------- */
.catalog-layout { display: grid; grid-template-columns: 280px 1fr; gap: 30px; align-items: start; }
.filters {
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
  padding: 22px; position: sticky; top: 90px;
}
.filters .btn { width: 100%; margin-top: 6px; }
.catalog-toolbar { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.sort-field { min-width: 230px; margin-bottom: 0; }
.active-filters { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; }
.chip {
  display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px;
  background: var(--navy); color: #fff; border-radius: 20px; font-size: .78rem; border: 0; cursor: pointer;
}
.chip:hover { background: var(--navy-2); }
.chip::after { content: "×"; font-weight: 700; }
.catalog-state {
  text-align: center; padding: 50px 20px; color: var(--muted);
  background: #fff; border: 1px dashed var(--border); border-radius: var(--radius); margin-bottom: 20px;
}
.catalog-error { border-color: #f5c6c0; background: #fdecea; color: #a33; }
.spinner {
  width: 26px; height: 26px; margin: 0 auto 10px; border-radius: 50%;
  border: 3px solid var(--border); border-top-color: var(--gold);
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.pagination { display: flex; gap: 8px; justify-content: center; margin-top: 28px; }
.page-btn {
  width: 38px; height: 38px; border-radius: 8px; border: 1px solid var(--border);
  background: #fff; cursor: pointer; font: 500 .9rem var(--font-body); color: var(--text);
}
.page-btn.active { background: var(--navy); color: #fff; border-color: var(--navy); }
.page-btn:hover:not(.active) { border-color: var(--gold); }

/* --- Страница тура ------------------------------------------------------------ */
.tour-layout { display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: start; }
.tour-gallery img { border-radius: var(--radius); width: 100%; max-height: 460px; object-fit: cover; margin-bottom: 24px; }
.tour-location { color: var(--muted); margin: 8px 0 22px; }
.tour-main h2 { font-size: 1.25rem; margin: 30px 0 10px; }
.tour-main p { color: var(--text); }
.tour-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
.tour-facts dt { font-size: .76rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
.tour-facts dd { font-weight: 500; color: var(--navy); }
.price-box {
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
  padding: 26px; position: sticky; top: 90px; box-shadow: var(--shadow);
}
.price-box .tour-card-price { font-size: 1.8rem; }
.price-box .request-form { margin-top: 18px; }
.price-box .form-row { grid-template-columns: 1fr; gap: 0; }

/* --- Подвал ------------------------------------------------------------------- */
.footer { background: var(--navy); color: rgba(255,255,255,.75); padding: 56px 0 0; margin-top: 20px; }
.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 36px; }
.footer h4 { color: #fff; font-family: var(--font-body); font-size: .85rem; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 14px; }
.footer a { display: block; color: rgba(255,255,255,.75); font-size: .9rem; padding: 3px 0; }
.footer a:hover { color: var(--gold); }
.footer p { font-size: .9rem; padding: 3px 0; }
.footer-tagline { margin-top: 12px; color: var(--gold); font-family: var(--font-head); font-style: italic; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,.12); margin-top: 40px; padding-top: 18px; padding-bottom: 18px; font-size: .8rem; }

/* --- Анимации появления ---------------------------------------------------------- */
.reveal { opacity: 0; transform: translateY(18px); transition: opacity .5s ease, transform .5s ease; }
.reveal.visible { opacity: 1; transform: none; }

/* --- Админка ---------------------------------------------------------------------- */
.admin-body { background: var(--bg); }
.admin-header { background: var(--navy); padding: 12px 0; }
.admin-header-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
.admin-nav { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
.admin-nav a { color: rgba(255,255,255,.82); font-size: .9rem; }
.admin-nav a:hover { color: var(--gold); }
.admin-main { padding: 36px 0 80px; }
.admin-main h1 { margin-bottom: 22px; }
.admin-main h2 { margin: 30px 0 14px; font-size: 1.2rem; }
.login-box { max-width: 380px; margin: 60px auto; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 30px; }
.login-box h1 { font-size: 1.4rem; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
.stat { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; text-align: center; color: var(--muted); font-size: .9rem; }
.stat-num { font-family: var(--font-head); font-size: 2rem; font-weight: 700; color: var(--navy); }
.table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; font-size: .88rem; }
.table th { background: var(--navy); color: #fff; text-align: left; padding: 10px 12px; font-weight: 500; white-space: nowrap; }
.table td { padding: 10px 12px; border-top: 1px solid var(--border); vertical-align: top; }
.table tr:hover td { background: #fafbfc; }
.inline-form { display: inline; }
.status { padding: 3px 10px; border-radius: 14px; font-size: .75rem; font-weight: 600; white-space: nowrap; }
.status-new { background: #eaf1fb; color: #20519c; }
.status-in_progress { background: #fdf3e0; color: #a86a1f; }
.status-done { background: #e8f6ee; color: #1d7a4c; }
.flash { background: #e8f6ee; border: 1px solid #bfe3cf; color: #1d7a4c; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: .9rem; }
.flash-warn { background: #fdf3e0; border-color: #f0dcb5; color: #a86a1f; }
.admin-form { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; }
.admin-form .form-row { grid-template-columns: 1fr 1fr 1fr; }
.admin-form .checkboxes { display: flex; gap: 24px; flex-wrap: wrap; align-items: center; margin-bottom: 18px; }
.admin-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.tabs { display: flex; gap: 8px; margin-bottom: 18px; }
.tab { padding: 7px 16px; border-radius: 20px; border: 1px solid var(--border); background: #fff; font-size: .85rem; }
.tab.active { background: var(--navy); color: #fff; border-color: var(--navy); }
.actions { white-space: nowrap; }
code { background: #eef1f5; padding: 2px 7px; border-radius: 5px; font-size: .85em; }

/* --- Адаптив ------------------------------------------------------------------------ */
@media (max-width: 1024px) {
  .dest-grid { grid-template-columns: repeat(2, 1fr); }
  .tours-grid, .tours-grid-sm { grid-template-columns: repeat(2, 1fr); }
  .steps, .steps-6 { grid-template-columns: repeat(2, 1fr); }
  .search-grid { grid-template-columns: repeat(2, 1fr); }
  .tour-layout { grid-template-columns: 1fr; }
  .price-box { position: static; }
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .media-split { gap: 28px; }
  .media-split img { height: 320px; }
}

@media (max-width: 720px) {
  .nav {
    position: absolute; top: 100%; left: 0; right: 0; height: 100vh;
    background: var(--navy); z-index: 99;
    flex-direction: column; align-items: center; justify-content: flex-start;
    padding-top: 8vh; gap: 26px;
    opacity: 0; pointer-events: none; transition: opacity .25s;
  }
  .nav.open { opacity: 1; pointer-events: auto; }
  .nav a { font-size: 1.2rem; }
  .burger { display: block; position: relative; z-index: 101; }
  .burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger.open span:nth-child(2) { opacity: 0; }
  .burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .header-contacts .btn { display: none; }
  .dest-grid, .tours-grid, .tours-grid-sm, .steps, .steps-6, .search-grid, .form-row,
  .admin-form .form-row, .stats-grid, .split, .catalog-layout, .media-split,
  .dir-grid, .dir-detail, .projects-grid { grid-template-columns: 1fr; }
  .media-split img { height: 240px; }
  .filters { position: static; }
  .footer-grid { grid-template-columns: 1fr; }
  .section { padding: 52px 0; }
  .tour-facts { grid-template-columns: 1fr; }
  .hero-stage { align-items: flex-start; }
  .hero-content { padding-top: 13vh; }
}
