<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ meta_title or "Business Travel — путешествия, продуманные до мелочей" }}</title>
<meta name="description" content="{{ meta_description or 'Туристическое агентство Business Travel в Томске.' }}">
<meta property="og:title" content="{{ meta_title or 'Business Travel' }}">
<meta property="og:description" content="{{ meta_description or '' }}">
<meta property="og:type" content="website">
<link rel="icon" type="image/svg+xml" href="{{ url_for('static', filename='img/favicon.svg') }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
{% block head %}{% endblock %}
</head>
<body>

<header class="header" id="header">
  <div class="container header-inner">
    <a href="{{ url_for('index') }}" class="logo" aria-label="Business Travel — на главную">
      <svg class="logo-mark" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
        <circle cx="20" cy="20" r="17" fill="none" stroke="#C7A66A" stroke-width="1.6"/>
        <path d="M8 24 Q20 12 32 22" fill="none" stroke="#C7A66A" stroke-width="1.6" stroke-linecap="round"/>
        <circle cx="27" cy="15" r="2.2" fill="#C7A66A"/>
      </svg>
      <span class="logo-text">Business <em>Travel</em></span>
    </a>

    <nav class="nav" id="nav" aria-label="Основная навигация">
      <a href="{{ url_for('index') }}">Главная</a>
      <a href="{{ url_for('index') }}#services">Услуги</a>
      <a href="{{ url_for('projects') }}">Проекты</a>
      <a href="{{ url_for('about') }}">О компании</a>
      <a href="{{ url_for('contacts') }}">Контакты</a>
    </nav>

    <div class="header-contacts">
      {% if settings.phone and '_' not in settings.phone %}
      <a class="header-phone" href="tel:{{ settings.phone|replace(' ','')|replace('(','')|replace(')','')|replace('-','') }}">{{ settings.phone }}</a>
      {% endif %}
      <a class="btn btn-gold btn-sm" href="{{ url_for('index') }}#contacts">Оставить заявку</a>
    </div>

    <button class="burger" id="burger" aria-label="Открыть меню" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
{% block content %}{% endblock %}
</main>

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a href="{{ url_for('index') }}" class="logo logo-light">
        <svg class="logo-mark" viewBox="0 0 40 40" width="32" height="32" aria-hidden="true">
          <circle cx="20" cy="20" r="17" fill="none" stroke="#C7A66A" stroke-width="1.6"/>
          <path d="M8 24 Q20 12 32 22" fill="none" stroke="#C7A66A" stroke-width="1.6" stroke-linecap="round"/>
          <circle cx="27" cy="15" r="2.2" fill="#C7A66A"/>
        </svg>
        <span class="logo-text">Business <em>Travel</em></span>
      </a>
      <p class="footer-tagline">Путешествия, продуманные до мелочей.</p>
    </div>
    <nav aria-label="Навигация в подвале">
      <h4>Разделы</h4>
      <a href="{{ url_for('events') }}">Организация мероприятий</a>
      <a href="{{ url_for('business_travel') }}">Деловые поездки</a>
      <a href="{{ url_for('individual') }}">Индивидуальные путешествия</a>
      <a href="{{ url_for('projects') }}">Проекты</a>
      <a href="{{ url_for('catalog') }}">Подбор тура</a>
      <a href="{{ url_for('specials') }}">Специальные предложения</a>
      <a href="{{ url_for('faq') }}">Частые вопросы</a>
      <a href="{{ url_for('about') }}">О компании</a>
    </nav>
    <div>
      <h4>Контакты</h4>
      {% if settings.phone and '_' not in settings.phone %}<p>{{ settings.phone }}</p>{% endif %}
      {% if settings.email %}<p>{{ settings.email }}</p>{% endif %}
      {% if settings.address %}<p>{{ settings.address }}</p>{% endif %}
      {% if settings.work_hours %}<p>{{ settings.work_hours }}</p>{% endif %}
    </div>
    <nav aria-label="Юридическая информация">
      <h4>Информация</h4>
      <a href="{{ url_for('privacy') }}">Политика обработки персональных данных</a>
      <a href="{{ url_for('consent') }}">Согласие на обработку персональных данных</a>
      <a href="{{ url_for('terms') }}">Условия и правила подачи заявки</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© Business Travel, Томск</span>
  </div>
</footer>

<script src="{{ url_for('static', filename='js/main.js') }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
